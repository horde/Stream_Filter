{
    "name": "horde/stream_filter",
    "description": "PHP stream filters library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Stream_Filter",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "bin2hex",
        "eol",
        "htmlspecialchars"
    ],
    "time": "2026-04-22",
    "repositories": [],
    "require": {
        "php": "^7.4 || ^8"
    },
    "require-dev": {},
    "suggest": {
        "horde/test": "^3 || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "psr-0": {
            "Horde_Stream_Filter": "lib/"
        },
        "psr-4": {
            "Horde\\Stream\\Filter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Stream\\Filter\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}